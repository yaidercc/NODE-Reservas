{
  "name": "reservas",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cross-env DB_SCHEMA=e2e_testing jest --maxWorkers=1",
    "test:unit": "jest --testRegex=Unit\\\\.test\\\\.js$ ",
    "test:integration": "jest --testRegex=Integration\\\\.test\\\\.js$ ",
    "test:e2e": "cross-env DB_SCHEMA=e2e_testing jest --testRegex=E2E\\\\.test\\\\.js$ --maxWorkers=1",
    "migrate:latest": "knex --knexfile=./config/database/knexfile.js migrate:latest\n",
    "migrate:rollback": "knex --knexfile=./config/database/knexfile.js migrate:rollback --all\n",
    "migrate:seed": "knex --knexfile=./config/database/knexfile.js seed:run\n",
    "migrate:reset": "npm run migrate:rollback && npm run migrate:latest && npm run migrate:seed",
    "api": "cross-env DB_SCHEMA=public nodemon app.js",
    "build": "npx swagger-cli bundle src/swagger/api.yaml --outfile src/swagger/dist/api.yaml --type yaml --dereference"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "_moduleAliases": {
    "@api": "./api",
    "@core": "src/core"
  },
  "dependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "axios": "^1.8.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "live-server": "^1.2.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chance": "^1.1.12",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pg": "^8.13.3",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "uuid": "^11.1.0"
  }
}
